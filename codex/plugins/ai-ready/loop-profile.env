# ai-ready codex loop 프로필 — 모델·effort 를 여기 한 곳에서 바꾼다.
# loop-launch.sh 가 이 파일을 읽어 `codex exec -m <model> -c model_reasoning_effort=<effort>` 로 세션을 띄운다.
# 세션 model·effort 는 위임된 maker/checker 하위 에이전트로 상속된다(균일 프로필 — 역할별 티어는 후속).
#
# LOOP_MODEL: codex 구체 모델명. 예: gpt-5.6-sol | gpt-5.6-terra | gpt-5.6-luna.
#             맨 계열명 gpt-5.6 은 거부된다(구체 모델을 써야 함).
# LOOP_EFFORT: 중립 effort 사다리 등급(minimal|low|medium|high|xhigh|max). core/effort-ladder.md 참조.
#             codex 는 이 등급을 그대로 받는다(xhigh 는 모델 의존).
LOOP_MODEL=gpt-5.6-sol
LOOP_EFFORT=high
